# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables. Never commit real values.

# Claude API (console.anthropic.com → API keys). Turns on setup + chat.
ANTHROPIC_API_KEY=

# Supabase (Project → Settings → API). Without these, saved businesses
# only live in memory and disappear on restart.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: require this code on /setup so strangers can't spend AI credit.
SETUP_ACCESS_CODE=

# Optional cost guards (defaults shown)
DAILY_MESSAGE_CAP=200
DAILY_EXTRACTION_CAP=30
